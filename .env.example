# Croma Deals bot — copy to .env and fill in your own values. Never commit .env.
# Copy to .env for local runs: node bot/run.js --dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum discount to alert on (per-group overrides live in bot/config.json)
MIN_DISCOUNT=60
MAX_WORKERS=3
PAGES=2
# Pincode Croma uses for prices/availability in the bot's scans
CROMA_PINCODE=400049
# Optional
# THRESHOLDS=c10=50,c997=55
# GROUPS=c997,c10,c20
# DIGEST_HOUR_IST=9
# MAX_ALERTS=40
